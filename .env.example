# =====================================================================
# File MẪU biến môi trường. Sao chép thành `.env` rồi điền giá trị thật.
#   PowerShell:  Copy-Item .env.example .env
# KHÔNG commit file .env (đã có trong .gitignore).
# =====================================================================

# ---- Môi trường chạy: development | test | production ----
NODE_ENV=development

# ---- PostgreSQL chạy bằng Docker Compose ----
POSTGRES_USER=kpi_app
# Bắt buộc đặt mật khẩu mạnh (>= 16 ký tự ngẫu nhiên). Ví dụ tạo nhanh trong PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 24 | % {[char]$_})
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=web_kpi_dev
# Cổng trên máy host (chỉ mở cho 127.0.0.1)
POSTGRES_PORT=5432

# Chuỗi kết nối cho Prisma/API — mật khẩu phải khớp POSTGRES_PASSWORD ở trên
DATABASE_URL=postgresql://kpi_app:CHANGE_ME@localhost:5432/web_kpi_dev?schema=public
# Database riêng cho kiểm thử tự động (được tạo sẵn khi container khởi tạo lần đầu)
TEST_DATABASE_URL=postgresql://kpi_app:CHANGE_ME@localhost:5432/web_kpi_test?schema=public

# ---- API ----
API_PORT=4000
# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy). Production phải ghi rõ domain HTTPS.
CORS_ORIGINS=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Đặt true khi API chạy sau reverse proxy (Nginx) để lấy đúng IP client
TRUST_PROXY=false
# Giới hạn kích thước JSON body
BODY_LIMIT=1mb

# ---- Phiên đăng nhập ----
# Khóa bí mật ký CSRF token (chuỗi ngẫu nhiên >= 32 ký tự). Tạo nhanh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME
# Phiên tự hết hạn khi không thao tác (phút) và tối đa kể từ khi đăng nhập (giờ)
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Khóa tạm tài khoản sau N lần sai mật khẩu liên tiếp, trong M phút
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Số lần gọi đăng nhập tối đa mỗi 15 phút từ một địa chỉ IP
LOGIN_RATE_LIMIT=20

# ---- Dữ liệu demo ----
# true: cho phép `npm run db:seed` nạp dữ liệu DEMO (tên giả). Luôn bị chặn khi NODE_ENV=production.
SEED_DEMO=true

# Mật khẩu dùng chung cho các tài khoản DEMO do seed tạo (để trống = không tạo tài khoản demo).
# Phải đạt chính sách mật khẩu (>= 12 ký tự, 3/4 loại ký tự). KHÔNG dùng ở môi trường thật.
# Lưu ý: nếu giá trị có ký tự # thì phải đặt trong dấu nháy kép "...", nếu không phần sau # bị coi là chú thích.
DEMO_USER_PASSWORD=

# ---- Frontend (Vite) ----
# Địa chỉ API mà Vite dev server chuyển tiếp /api tới (chỉ dùng khi dev, không nhúng vào bundle)
API_PROXY_TARGET=http://localhost:4000
